# Copy this file to a local .env and choose one credential source per provider.
# Prefer *_API_KEY_FILE for local development. Never commit the populated .env.
# Direct values and file pointers must not both be set for the same provider.

MODEL_PROVIDER=nvidia
PROVIDER_FALLBACK_ORDER=nvidia,mimo,deepseek,kimi
PAID_FALLBACK_ENABLED=false

NVIDIA_API_KEY=
NVIDIA_API_KEY_FILE=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

MIMO_API_KEY=
MIMO_API_KEY_FILE=
MIMO_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_MODEL=

KIMI_API_KEY=
KIMI_API_KEY_FILE=
KIMI_MODEL=

MAX_AGENT_STEPS=8
MODEL_TIMEOUT_SECONDS=45
AGENT_MAX_OUTPUT_TOKENS=
AGENT_REASONING_EFFORT=
AGENT_TEMPERATURE=
AGENT_VERBOSE=
MAX_REQUEST_BUDGET_CNY=0

LOG_LLM_MESSAGES=false
LOG_TOOL_RESULTS=false
