# Copy this file to a local .env and fill values only on your machine.
# Never commit the populated .env file.

MODEL_PROVIDER=nvidia
PROVIDER_FALLBACK_ORDER=nvidia,mimo,deepseek,kimi
PAID_FALLBACK_ENABLED=false

NVIDIA_API_KEY=
NVIDIA_MODEL=

MIMO_API_KEY=
MIMO_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

KIMI_API_KEY=
KIMI_MODEL=

MAX_AGENT_STEPS=8
MODEL_TIMEOUT_SECONDS=45
MAX_REQUEST_BUDGET_CNY=0

LOG_LLM_MESSAGES=false
LOG_TOOL_RESULTS=false
